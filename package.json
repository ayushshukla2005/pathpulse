{
  "name": "pathpulse",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter @pathpulse/config build && pnpm --filter @pathpulse/shared-types build && pnpm --filter @pathpulse/validation build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "format": "pnpm --recursive run format",
    "format:check": "pnpm --recursive run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
