generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  USER
  CONTRIBUTOR
  MODERATOR
  ORGANIZATION_ADMIN
  SUPER_ADMIN
}

enum MobilityProfile {
  WHEELCHAIR
  LIMITED_MOBILITY
  VISUAL_IMPAIRMENT
  HEARING_IMPAIRMENT
  STROLLER
  CUSTOM
}

enum ConnectionType {
  CORRIDOR
  RAMP
  STAIRS
  ELEVATOR
  DOOR
}

enum OperationalStatus {
  OPERATIONAL
  OUT_OF_SERVICE
  UNKNOWN
}

enum VerificationLevel {
  CONFIRMED
  UNVERIFIED
  UNAVAILABLE
}

enum ReportCategory {
  BROKEN_LIFT
  BLOCKED_RAMP
  INACCESSIBLE_ENTRANCE
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  RESOLUTION_SUBMITTED
  CLOSED
  REJECTED
  REOPENED
}

enum FacilityType {
  ELEVATOR
  RAMP
  ACCESSIBLE_RESTROOM
  ENTRANCE
  TACTILE_PAVING
  PARKING_BAY
  HELP_DESK
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  password_hash           String
  name                    String
  role                    UserRole              @default(USER)
  organization_id         String?
  organization            Organization?         @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  preferences             UserPreference?
  refresh_tokens          RefreshToken[]
  issue_reports           IssueReport[]
  verifications           Verification[]
  maintenance_tasks       MaintenanceTask[]
  notifications           Notification[]
  audit_logs              AuditLog[]

  @@index([organization_id])
  @@index([role])
  @@map("users")
}

model UserPreference {
  id                      String                @id @default(uuid())
  user_id                 String                @unique
  user                    User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mobility_profile        MobilityProfile       @default(CUSTOM)
  requires_step_free      Boolean               @default(false)
  requires_elevator       Boolean               @default(false)
  max_slope_percent       Float?
  min_door_width_cm       Int?
  requires_tactile_paving Boolean               @default(false)
  requires_audio_alerts   Boolean               @default(false)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  @@map("user_preferences")
}

model Organization {
  id                      String                @id @default(uuid())
  name                    String
  slug                    String                @unique
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  users                   User[]
  venues                  Venue[]
  maintenance_tasks       MaintenanceTask[]

  @@map("organizations")
}

model Venue {
  id                      String                @id @default(uuid())
  organization_id         String?
  organization            Organization?         @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  name                    String
  category                String
  address                 String?
  latitude                Float
  longitude               Float
  location                Unsupported("geography(Point, 4326)")?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  buildings               Building[]
  facilities              Facility[]
  issue_reports           IssueReport[]
  audit_logs              AuditLog[]

  @@index([organization_id])
  @@map("venues")
}

model Building {
  id                      String                @id @default(uuid())
  venue_id                String
  venue                   Venue                 @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  name                    String
  building_code           String?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  floors                  Floor[]
  map_nodes               MapNode[]
  map_edges               MapEdge[]
  facilities              Facility[]

  @@index([venue_id])
  @@map("buildings")
}

model Floor {
  id                      String                @id @default(uuid())
  building_id             String
  building                Building              @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_number            Int
  name                    String
  level_index             Int                   @default(0)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  map_nodes               MapNode[]
  facilities              Facility[]

  @@unique([building_id, floor_number])
  @@index([building_id])
  @@map("floors")
}

model MapNode {
  id                      String                @id @default(uuid())
  building_id             String
  building                Building              @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_id                String
  floor                   Floor                 @relation(fields: [floor_id], references: [id], onDelete: Cascade)
  node_type               String
  name                    String?
  x_coordinate            Float
  y_coordinate            Float
  latitude                Float?
  longitude               Float?
  is_accessible           Boolean               @default(true)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  outgoing_edges          MapEdge[]             @relation("FromNode")
  incoming_edges          MapEdge[]             @relation("ToNode")
  facilities              Facility[]

  @@index([building_id])
  @@index([floor_id])
  @@map("map_nodes")
}

model MapEdge {
  id                      String                @id @default(uuid())
  building_id             String
  building                Building              @relation(fields: [building_id], references: [id], onDelete: Cascade)
  from_node_id            String
  from_node               MapNode               @relation("FromNode", fields: [from_node_id], references: [id], onDelete: Cascade)
  to_node_id              String
  to_node                 MapNode               @relation("ToNode", fields: [to_node_id], references: [id], onDelete: Cascade)
  connection_type         ConnectionType        @default(CORRIDOR)
  distance_meters         Float
  step_free               Boolean               @default(true)
  width_cm                Int?
  slope_percent           Float?
  surface                 String?
  operational_status      OperationalStatus     @default(OPERATIONAL)
  verification_level      VerificationLevel     @default(CONFIRMED)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  @@unique([from_node_id, to_node_id])
  @@index([building_id])
  @@index([from_node_id])
  @@index([to_node_id])
  @@index([operational_status])
  @@map("map_edges")
}

model Facility {
  id                      String                @id @default(uuid())
  venue_id                String
  venue                   Venue                 @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  building_id             String?
  building                Building?             @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_id                String?
  floor                   Floor?                @relation(fields: [floor_id], references: [id], onDelete: SetNull)
  node_id                 String?
  node                    MapNode?              @relation(fields: [node_id], references: [id], onDelete: SetNull)
  facility_type           FacilityType
  name                    String
  operational_status      OperationalStatus     @default(OPERATIONAL)
  verification_level      VerificationLevel     @default(CONFIRMED)
  last_verified_at        DateTime?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  issue_reports           IssueReport[]

  @@index([venue_id])
  @@index([building_id])
  @@index([facility_type])
  @@index([operational_status])
  @@map("facilities")
}

model IssueReport {
  id                      String                @id @default(uuid())
  user_id                 String
  user                    User                  @relation(fields: [user_id], references: [id], onDelete: Restrict)
  venue_id                String
  venue                   Venue                 @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  facility_id             String?
  facility                Facility?             @relation(fields: [facility_id], references: [id], onDelete: SetNull)
  category                ReportCategory
  title                   String
  description             String
  status                  ReportStatus          @default(SUBMITTED)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  evidence                Evidence[]
  verifications           Verification[]
  maintenance_tasks       MaintenanceTask[]

  @@index([user_id])
  @@index([venue_id])
  @@index([facility_id])
  @@index([status])
  @@map("issue_reports")
}

model Evidence {
  id                      String                @id @default(uuid())
  report_id               String
  report                  IssueReport           @relation(fields: [report_id], references: [id], onDelete: Cascade)
  image_url               String
  file_key                String
  caption                 String?
  uploaded_at             DateTime              @default(now())

  @@index([report_id])
  @@map("evidence")
}

model Verification {
  id                      String                @id @default(uuid())
  report_id               String
  report                  IssueReport           @relation(fields: [report_id], references: [id], onDelete: Cascade)
  reviewer_id             String
  reviewer                User                  @relation(fields: [reviewer_id], references: [id], onDelete: Restrict)
  decision                String
  notes                   String?
  created_at              DateTime              @default(now())

  @@index([report_id])
  @@index([reviewer_id])
  @@map("verifications")
}

model MaintenanceTask {
  id                      String                @id @default(uuid())
  report_id               String
  report                  IssueReport           @relation(fields: [report_id], references: [id], onDelete: Cascade)
  organization_id         String
  organization            Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assigned_to_id          String?
  assigned_to             User?                 @relation(fields: [assigned_to_id], references: [id], onDelete: SetNull)
  status                  String                @default("PENDING")
  priority                String                @default("MEDIUM")
  resolution_notes        String?
  resolved_at             DateTime?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  @@index([report_id])
  @@index([organization_id])
  @@index([assigned_to_id])
  @@index([status])
  @@map("maintenance_tasks")
}

model Notification {
  id                      String                @id @default(uuid())
  user_id                 String
  user                    User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title                   String
  message                 String
  link                    String?
  read_at                 DateTime?
  created_at              DateTime              @default(now())

  @@index([user_id])
  @@index([read_at])
  @@map("notifications")
}

model AuditLog {
  id                      String                @id @default(uuid())
  user_id                 String?
  user                    User?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action                  String
  entity_type             String
  entity_id               String
  venue_id                String?
  venue                   Venue?                @relation(fields: [venue_id], references: [id], onDelete: SetNull)
  changes                 Json?
  created_at              DateTime              @default(now())

  @@index([entity_id])
  @@index([entity_type])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_logs")
}

model RefreshToken {
  id                      String                @id @default(uuid())
  user_id                 String
  user                    User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash              String                @unique
  expires_at              DateTime
  revoked                 Boolean               @default(false)
  created_at              DateTime              @default(now())

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}
